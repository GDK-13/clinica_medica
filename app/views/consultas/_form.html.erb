<%= form_with(model: consulta, local: true) do |form| %>
  <% if consulta.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <h5 class="h6"><%= pluralize(consulta.errors.count, "erro") %> impediram a gravação:</h5>
      <ul class="mb-0 small">
        <% consulta.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :paciente_id, "Paciente", class: "form-label fw-bold" %>
    <%= form.collection_select :paciente_id, Paciente.all, :id, :nome, { prompt: "Selecione o paciente" }, { class: "form-select" } %>
  </div>
  <div class="mb-3">
    <%= form.label :medico_id, "Médico", class: "form-label fw-bold" %>
    <%= form.collection_select :medico_id, Medico.all, :id, :nome, { prompt: "Selecione o médico" }, { class: "form-select" } %>
  </div>
  <div class="mb-3">
    <%= form.label :data_hora, "Data e Hora", class: "form-label fw-bold" %>
    <%= form.datetime_field :data_hora, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :observacoes, "Observações", class: "form-label fw-bold" %>
    <%= form.text_area :observacoes, class: "form-control", rows: 3, placeholder: "Histórico clínico ou notas da triagem..." %>
  </div>
  <div class="d-flex gap-2 mt-4">
    <%= form.submit "Salvar Registro", class: "btn btn-success" %>
    <%= link_to "Cancelar", consultas_path, class: "btn btn-secondary" %>
  </div>
<% end %>