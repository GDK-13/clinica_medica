<div class="card shadow-sm mb-4 mt-3">
  <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
    <h2 class="h5 mb-0">Detalhes da Consulta</h2>
    <%= link_to "Voltar", consultas_path, class: "btn btn-sm btn-outline-light" %>
  </div>
  <div class="card-body">
    <ul class="list-group list-group-flush">
      <li class="list-group-item"><strong>Paciente:</strong> <%= @consulta.paciente&.nome || 'Não informado' %></li>
      <li class="list-group-item"><strong>Médico:</strong> <%= @consulta.medico&.nome || 'Não informado' %></li>
      <li class="list-group-item"><strong>Data e Hora:</strong> <%= @consulta.data_hora&.strftime("%d/%m/%Y %H:%M") || 'Não informada' %></li>
      <li class="list-group-item"><strong>Observações:</strong> <%= @consulta.observacoes.presence || 'Nenhuma observação registrada.' %></li>
    </ul>
  </div>
  <div class="card-footer bg-light d-flex justify-content-end gap-2">
    <%= link_to "Editar", edit_consulta_path(@consulta), class: "btn btn-warning" %>
    <%= button_to "Excluir", @consulta, method: :delete, form: { data: { turbo_confirm: 'Confirma a exclusão desta consulta?' } }, class: "btn btn-danger" %>
  </div>
</div>