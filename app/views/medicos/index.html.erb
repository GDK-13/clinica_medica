<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
  <h1>Médicos Cadastrados</h1>
  <%= link_to "Novo Médico", new_medico_path, class: "btn btn-primary" %>
</div>
<div class="table-responsive">
  <table class="table table-striped table-hover table-bordered align-middle">
    <thead class="table-dark">
      <tr>
        <th>Nome</th>
        <th>CRM</th>
        <th>Especialidade</th>
        <th colspan="3" class="text-center">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @medicos.each do |medico| %>
        <tr>
          <td><%= medico.nome %></td>
          <td><%= medico.crm %></td>
          <td><%= medico.especialidade %></td>
          <td class="text-center"><%= link_to "Ver", medico, class: "btn btn-sm btn-info text-white" %></td>
          <td class="text-center"><%= link_to "Editar", edit_medico_path(medico), class: "btn btn-sm btn-warning" %></td>
          <td class="text-center">
            <%= button_to "Excluir", medico, method: :delete, form: { data: { turbo_confirm: 'Tem certeza que deseja excluir este médico?' } }, class: "btn btn-sm btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>