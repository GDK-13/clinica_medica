<%= form_with(model: medico, local: true) do |form| %>
  <% if medico.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <h5 class="h6"><%= pluralize(medico.errors.count, "erro") %> impediram a gravação:</h5>
      <ul class="mb-0 small">
        <% medico.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :nome, "Nome do Profissional", class: "form-label fw-bold" %>
    <%= form.text_field :nome, class: "form-control", placeholder: "Digite o nome completo" %>
  </div>
  <div class="mb-3">
    <%= form.label :crm, "CRM", class: "form-label fw-bold" %>
    <%= form.text_field :crm, class: "form-control", placeholder: "00000-UF" %>
  </div>
  <div class="mb-3">
    <%= form.label :especialidade, "Especialidade", class: "form-label fw-bold" %>
    <%= form.text_field :especialidade, class: "form-control", placeholder: "Ex: Clínica Médica" %>
  </div>
  <div class="d-flex gap-2 mt-4">
    <%= form.submit "Salvar Registro", class: "btn btn-success" %>
    <%= link_to "Cancelar", medicos_path, class: "btn btn-secondary" %>
  </div>
<% end %>